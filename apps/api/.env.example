# Runtime
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_QUARANTINE_ENCRYPTION_KEY=
QUARANTINE_REPLAY_MAX_ATTEMPTS=5
QUARANTINE_REPLAY_LEASE_SECONDS=900

# PostgreSQL / Supabase (required)
# DATABASE_URL is recommended outside Supabase-style deployments. When it is
# set, the individual SUPABASE_DB_* values are not required.
DATABASE_URL=
DATABASE_SSLMODE=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace_me
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# Clerk authentication (required outside local development)
CLERK_ISSUER_URL=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# Legacy manager endpoints. Use a generated secret outside local development.
MANAGER_API_KEY=replace_with_a_random_secret

# WhatsApp transport. Keep "meta" for production; "wazzap" is the temporary
# Pilot transport used before the Meta Business portfolio is verified.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=replace_with_a_random_secret
META_WA_API_VERSION=v22.0
META_APP_ID=
META_APP_SECRET=
# Configuration ID created in Meta > Facebook Login for Business > Configurations.
# The legacy Render name META_CONFIGURATION_ID is also accepted.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Generate with the same Fernet command shown at the top of this file.
META_CREDENTIALS_ENCRYPTION_KEY=
# The two redirect values below are only needed by the legacy OAuth redirect flow.
# Pilot V1 uses Embedded Signup and never asks the agency for an access token.
META_REDIRECT_URI=
META_OAUTH_FRONTEND_REDIRECT_URI=

# Temporary Wazzap Pilot transport
WAZZAP_API_BASE_URL=https://api21.wazzap.ai/api/wazzap
WAZZAP_API_KEY=
WAZZAP_AGENT_ID=
WAZZAP_ORGANIZATION_ID=
WAZZAP_WEBHOOK_SECRET=
WAZZAP_WEBHOOK_SKIP_SIGNATURE_CHECK=false
WAZZAP_PHONE_NUMBER=
WAZZAP_VERIFIED_NAME=

# Optional temporary linked-device Pilot gateway. Keep WHATSAPP_PROVIDER=meta;
# organization routing selects QR_LINKED_DEVICE only for a connected agency.
WHATSAPP_QR_GATEWAY_URL=
WHATSAPP_QR_GATEWAY_SHARED_SECRET=
WHATSAPP_QR_PILOT_MAX_ORGANIZATIONS=10

# AI
MISTRAL_API_KEY=
VOICE_TRANSCRIPTION_PROVIDER=mistral
KNOWLEDGE_EMBEDDING_MODEL=mistral-embed
KNOWLEDGE_OCR_MODEL=mistral-ocr-latest

# Knowledge file security and external sources
# Production imports fail closed when ClamAV is unavailable.
KNOWLEDGE_ANTIVIRUS_REQUIRED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Generate a Fernet key; never reuse an OAuth token here.
KNOWLEDGE_CONNECTOR_ENCRYPTION_KEY=
