# Public URL of the FastAPI service. Required in staging and production.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Clerk publishable key. Required in staging and production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional deployment metadata used to create deterministic build identifiers.
RAILWAY_GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_SHA=
